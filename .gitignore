*~
# een geheugendump van de JVM (Android Studio zet hem in de
# projectmap): honderden MB, en boven de 100 MB weigert GitHub de
# hele push — ook als het bestand allang weg is, want het staat dan
# nog in je geschiedenis
*.hprof

# sleutels en wachtwoorden horen niet in de geschiedenis
.env
.env.*
!.env.example
*.pem
*.key

# flutter/dart
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/
.pub-cache/
.pub/
ios/Pods/
ios/.symlinks/
android/.gradle/
android/local.properties

# gegenereerd per machine (pad + extension-id)
extension/host/com.downoader.host.json

# tijdelijke debug-logs
err*.txt
err_test.txt


# Windows installer build artifacts
dist/
.tools-cache/

# Private key for fixed Chrome extension ID (public key zit in manifest.json)
installer/extension-key.pem


# Gebundelde binaries (ffmpeg/deno te groot voor GitHub; horen in Setup.exe / Releases)
Release/tools/

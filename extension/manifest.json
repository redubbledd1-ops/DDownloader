{
  "manifest_version": 3,
  "name": "Downloader",
  "version": "1.0.0",
  "description": "Download de huidige tab via de lokale Downloader Native Messaging host (yt-dlp).",
  "action": {
    "default_title": "Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["nativeMessaging", "activeTab", "tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  }
}
